# Set to false to force MySQL connection
USE_SQLITE_FALLBACK=false

# Security & App Settings
JWT_SECRET_KEY=sichai_pani_secure_jwt_secret_key_2026_x987
WATER_RATE_PER_HOUR=200.0

# Google Auth
GOOGLE_CLIENT_ID=689098637340-sh3f1per7t6lk73ueopffqcl2ba2he47.apps.googleusercontent.com
ALLOW_GOOGLE_SIGNIN_DEV=true

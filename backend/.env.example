# MySQL connection (production)
DATABASE_URL=mysql+pymysql://sichai_user:sichai_pass@localhost:3306/sichai_pani

# For local dev without a MySQL server, SQLite is used automatically as a fallback
# (see app/config.py). Set USE_SQLITE_FALLBACK=false to force MySQL.
USE_SQLITE_FALLBACK=true

JWT_SECRET_KEY=change_this_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

WATER_RATE_PER_HOUR=200
CURRENCY=Rs.
COMPANY_NAME=Sichai Pani Irrigation Services

# Payment gateway keys (fill in for production)
ESEWA_MERCHANT_ID=
KHALTI_SECRET_KEY=
FONEPAY_MERCHANT_ID=

# Google Sign-In (create at https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=

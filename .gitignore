# Environment files (contain secrets - never commit these)
backend/.env
frontend/.env
*.env

# Python
backend/.venv/
backend/__pycache__/
backend/**/__pycache__/
*.pyc
*.pyo

# Local database
backend/sichai_pani.db
backend/data/*.db

# Uploaded files (payment proofs, etc.)
backend/uploads/*
!backend/uploads/.gitkeep

# Node / Build artifacts
frontend/node_modules/
frontend/dist/
frontend/android/app/build/
frontend/android/build/

# OS/editor junk
.DS_Store
Thumbs.db
*.tmp
*.log